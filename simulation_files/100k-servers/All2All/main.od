[
	Plots
	{
		selector:=configuration.traffic.legend_name, //Make a plot for each value of the selector
		kind: [Plotkind{
			abscissas: =configuration.topology.legend_name,
			parameter: =configuration.topology.legend_name,
			label_abscissas: "offered load",
			ordinates: =result.linux_high_water_mark,
			label_ordinates: "peak memory",
			min_ordinate: 0.0,
			//max_ordinate: 1.0,
			raw:"y memory ticks from kilobytes,",
		}],
		legend: =configuration.traffic.map.legend_name,
		prefix: "memory",
		backend: Tikz
		{
			tex_filename: "peak_memory.tex",
			pdf_filename: "peak_memory.pdf",
		},
	},
	Plots
	{
		selector: [
			=configuration.traffic.legend_name,
			=configuration.traffic.map.legend_name, 
		],//Make a plot for each value of the selector
		kind: [Plotkind{
			label_abscissas: "path length",
			label_ordinates: "amount fo packets",
			histogram: =result.total_packet_per_hop_count,
			min_ordinate: 0.0,
			//max_ordinate: 1.0,
		}],
		legend: =configuration.topology.legend_name,
		prefix: "hophistogram",
		backend: Tikz
		{
			tex_filename: "hop_histogram.tex",
			pdf_filename: "hop_histogram.pdf",
		},
	},
	Plots
	{
		selector: [
			=configuration.traffic.legend_name,
			//=configuration.random_seed,
		],//Make a plot for each value of the selector
		kind: [
			Plotkind{
				bar: true,
				label_abscissas: "Number of App blocks",
				label_ordinates: "Cycles to finish",
				min_ordinate: 0.0,
				min_abscissa: 000,
				ordinates: = result.cycle,
				abscissas: =configuration.topology.legend_name,
				parameter: =configuration.topology.legend_name,
			}
		],
		legend: [
			//=configuration.routing.legend_name,
			=configuration.traffic.map.legend_name, 
		],
		prefix: "throughput",
		backend: Tikz
		{
			tex_filename: "cycles.tex",
			pdf_filename: "cycles.pdf",
		},
	},
]


